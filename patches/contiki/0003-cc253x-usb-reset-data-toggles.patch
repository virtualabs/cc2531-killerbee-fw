From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Orion Parker <331738732+orionparker33@users.noreply.github.com>
Date: Sun, 18 Oct 2026 04:57:06 +0100
Subject: [PATCH] cc253x/usb: reset data toggles on SET_CONFIGURATION and
 ClearFeature(HALT)

The host resets its data toggles and clears endpoint halts on every
SET_CONFIGURATION (USB 2.0 9.1.1.5, 9.4.5), and resets an endpoint's
toggle on ClearFeature(ENDPOINT_HALT). The CC253x port never reset its
own, so after either request the endpoints were one toggle off and the
next bulk packet was lost.

- usb-core.c: call usb_arch_set_configuration() on every
  SET_CONFIGURATION, including a repeated one, before the status stage.
- usb-arch.c: usb_arch_set_configuration() clears halts and resets the IN
  and OUT data toggles (CLR_DATA_TOG) of every non-control endpoint. This
  is done here and not in usb_arch_setup_in/out_endpoint(), which runs
  later from the application's CONFIG event and would race a fast host.
- usb-arch.c: ClearFeature(ENDPOINT_HALT) also resets the endpoint's data
  toggle, and restarts the matching direction (it always called the OUT
  handler, even for an IN endpoint).
---
 cpu/cc253x/usb/common/usb-core.c |  6 +++++-
 cpu/cc253x/usb/usb-arch.c        | 36 ++++++++++++++++++++++++++++++--
 2 files changed, 39 insertions(+), 3 deletions(-)

diff --git a/cpu/cc253x/usb/common/usb-core.c b/cpu/cc253x/usb/common/usb-core.c
index c5d3afa..95767f3 100644
--- a/cpu/cc253x/usb/common/usb-core.c
+++ b/cpu/cc253x/usb/common/usb-core.c
@@ -212,9 +212,13 @@ static int
 set_configuration()
 {
   notify_user(USB_EVENT_CONFIG);
+  /*
+   * Also on a repeated SET_CONFIGURATION: the host resets its data toggles
+   * either way, so the arch layer must reset its own before the status stage.
+   */
+  usb_arch_set_configuration(LOW_BYTE(usb_setup_buffer.wValue));
   if(usb_configuration_value != LOW_BYTE(usb_setup_buffer.wValue)) {
     usb_configuration_value = LOW_BYTE(usb_setup_buffer.wValue);
-    usb_arch_set_configuration(usb_configuration_value);
     usb_send_ctrl_status();
     return 1;
   } else {
diff --git a/cpu/cc253x/usb/usb-arch.c b/cpu/cc253x/usb/usb-arch.c
index 74d18e3..3a85057 100644
--- a/cpu/cc253x/usb/usb-arch.c
+++ b/cpu/cc253x/usb/usb-arch.c
@@ -62,6 +62,7 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #define USBCS0_INPKT_RDY	(1 << 1)
 #define USBCS0_OUTPKT_RDY	(1 << 0)
 
+#define USBCSIL_CLR_DATA_TOG	(1 << 6)
 #define USBCSIL_SENT_STALL	(1 << 5)
 #define USBCSIL_SEND_STALL	(1 << 4)
 #define USBCSIL_FLUSH_PACKET	(1 << 3)
@@ -69,6 +70,7 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #define USBCSIL_PKT_PRESENT	(1 << 1)
 #define USBCSIL_INPKT_RDY	(1 << 0)
 
+#define USBCSOL_CLR_DATA_TOG	(1 << 7)
 #define USBCSOL_SENT_STALL	(1 << 6)
 #define USBCSOL_SEND_STALL	(1 << 5)
 #define USBCSOL_OVERRUN		(1 << 2)
@@ -757,6 +759,16 @@ usb_arch_halt_endpoint(uint8_t addr, int halt)
     ep->halted = 0;
     set_stall(addr, 0);
 
+    /* ClearFeature(ENDPOINT_HALT) always resets the data toggle to DATA0 */
+    if(ei) {
+      USBINDEX = ei;
+      if(addr & 0x80) {
+        USBCSIL |= USBCSIL_CLR_DATA_TOG;
+      } else {
+        USBCSOL |= USBCSOL_CLR_DATA_TOG;
+      }
+    }
+
     if(ep->buffer && (ep->buffer->flags & USB_BUFFER_HALT)) {
       ep->buffer->flags &= ~USB_BUFFER_SUBMITTED;
       if(ep->buffer->flags & USB_BUFFER_NOTIFY) {
@@ -765,17 +777,37 @@ usb_arch_halt_endpoint(uint8_t addr, int halt)
       ep->buffer = ep->buffer->next;
     }
     if(ei) {
-      usb_arch_epout_irq(EP_HW_NUM(addr));
+      if(addr & 0x80) {
+        usb_arch_epin_irq(ei);
+      } else {
+        usb_arch_epout_irq(ei);
+      }
     }
   }
 
   usb_irq_enable(flag);
 }
 
+/*
+ * Called by usb-core on every SET_CONFIGURATION, before the status stage.
+ * The host resets its data toggles and clears endpoint halts on a
+ * SET_CONFIGURATION (USB 2.0 9.1.1.5, 9.4.5); do the same for every
+ * non-control endpoint here, before the host can start the next transfer.
+ */
 void
 usb_arch_set_configuration(uint8_t usb_configuration_value)
 {
-  // Nothing to do ?
+  uint8_t ei;
+  uint8_t flag;
+
+  usb_irq_disable(flag);
+  for(ei = 1; ei < USB_MAX_ENDPOINTS; ei++) {
+    usb_endpoints[ei].halted = 0;
+    USBINDEX = ei;
+    USBCSIL = (USBCSIL & ~USBCSIL_SEND_STALL) | USBCSIL_CLR_DATA_TOG;
+    USBCSOL = (USBCSOL & ~USBCSOL_SEND_STALL) | USBCSOL_CLR_DATA_TOG;
+  }
+  usb_irq_enable(flag);
 }
 
 uint16_t
